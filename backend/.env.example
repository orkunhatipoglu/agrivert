# Copy to .env and fill in. Never commit the real .env or the service-account
# JSON — both are credentials.

ENVIRONMENT=development
API_PREFIX=/api/v1

# --- Firebase ---
# Path to a service-account JSON, or leave blank to use
# GOOGLE_APPLICATION_CREDENTIALS / gcloud ADC / workload identity.
FIREBASE_CREDENTIALS_PATH=./secrets/serviceAccount.json
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# --- Celery / Redis ---
# In docker-compose this is redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=100

# --- Model registry ---
# Directory of versioned model dirs. Each holds best.pt + metadata.json + labels.json.
MODEL_REGISTRY_DIR=./models
# Fallback when Firestore has no active version (handy for local dev).
DEFAULT_MODEL_VERSION=
# Where predict.py and data.py live. Leave unset — they're vendored into
# backend/ itself. Only set this if you relocate them elsewhere.
ML_REPO_ROOT=
# Blank => cuda when available, else cpu. Force with "cpu" or "cuda".
INFERENCE_DEVICE=

# --- Upload validation ---
MAX_UPLOAD_BYTES=12582912
MIN_IMAGE_DIMENSION=64
