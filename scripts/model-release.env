# The currently published model bundle.
#
# This is the single source of truth for "which model do I install". The
# READMEs point here instead of repeating a URL and a hash, because when they
# were repeated in three files they drifted: all three documented
# v2-vertical-20260809, whose release exists but has no assets attached, so
# every documented install command 404'd while v3 was the live release.
#
# Read by scripts/model-download.sh, rewritten by scripts/model-upload.sh.

MODEL_VERSION="v3-vertical-20260809"
MODEL_URL="https://github.com/orkunhatipoglu/agrivert/releases/download/v3-vertical-20260809/v3-vertical-20260809.tar.gz"
